# Server-only credentials. Never add NEXT_PUBLIC_ to these variable names.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-secret-key
# Only needed before the first map is created. Set a private value with at least 12 characters.
# Remove this variable after initialization; it is separate from the editing password.
ATLAS_SETUP_KEY=
